{
  "name": "bills",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-30",
  "workers_dev": false,
  "assets": {
    "directory": "public",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/img/*", "/__scheduled"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bills",
      "database_id": "71ca9d04-73de-4202-bdcb-a293ab623bbd"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "bills"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "routes": [
    {
      "pattern": "bills.frostbun.com",
      "custom_domain": true
    }
  ]
}
